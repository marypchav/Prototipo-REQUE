# Copie este archivo como ".env" (en esta misma carpeta backend) y llénelo.
# El .env NUNCA se sube a git (está en el .gitignore).

# Puerto donde corre el servidor: http://localhost:3000
PORT=3000
NODE_ENV=development

# ---------------- SQL Server ----------------
# La base BDCapanni está en UNA sola computadora y los demás se conectan
# a ella por la VPN (Radmin VPN).
#   - En la computadora que tiene la base:  DB_SERVER=localhost
#   - En las demás:  DB_SERVER=<IP de la VPN de esa computadora>
DB_SERVER=localhost
DB_PORT=1433
# Dejar vacío. Solo se usa con SQL Server Express sin puerto fijo
DB_INSTANCE=
DB_NAME=BDCapanni
# Usuario de SQL Server con el que se conecta Node (autenticación SQL).
# La contraseña se pasa por un chat privado, nunca por el repo
DB_USER=capanni_app
DB_PASSWORD=
DB_ENCRYPT=false

# ---------------- Sesión de la administradora y del cliente (GI001, GP002) ----------------
# Texto largo y aleatorio. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Horas que dura la sesión
JWT_HORAS=8

# ---------------- Correos de pedidos (GP019) ----------------
# Opcional. Si SMTP_HOST queda vacío, los correos se guardan en la base
# (tabla Notificacion) y se envían cuando se configure.
# Además hay que instalar el paquete: npm install nodemailer
#
# Ejemplo con Gmail: active la verificación en dos pasos de la cuenta y cree
# una "contraseña de aplicación" (16 letras). Esa va en SMTP_CLAVE, NO la
# contraseña normal del correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE="Confecciones Capanni <correo@ejemplo.com>"
